              },
              {
                "key": "Authorization",
                "value": "Bearer {{aliceToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"memberId\":\"{{bobId}}\",\"role\":\"editor\"}"
            }
          }
        },
        {
          "name": "Update Board Settings (editor+)",
          "request": {
