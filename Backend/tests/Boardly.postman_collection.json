                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{bobToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"memberId\":\"{{bobId}}\",\"role\":\"editor\"}"
