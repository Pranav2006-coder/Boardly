{
  "name": "boardly-platform",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "server": "npm run dev --prefix Backend",
    "client": "npm run dev --prefix frontend",
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"bgBlue.bold,bgGreen.bold\" \"npm run server\" \"npm run client\"",
    "build": "npm run build --prefix frontend",
    "start": "npm start --prefix Backend",
    "test": "node Backend/tests/runTests.js"
  },
  "devDependencies": { "concurrently": "^9.1.2" }
}